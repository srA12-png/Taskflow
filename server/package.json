{
  "name": "taskflow-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TaskFlow Express + SQLite API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
