# ---------------------------------------------------------------
# TaskFlow environment variables
# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.
# ---------------------------------------------------------------

# --- Server -----------------------------------------------------
NODE_ENV=development

# Port the Express API listens on (client dev-server proxies /api here)
PORT=5000

# Secret used to sign JWTs. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# JWT lifetime, e.g. 7d, 12h
JWT_EXPIRES_IN=7d

# Allowed browser origin for CORS + cookies
CLIENT_ORIGIN=http://localhost:5173

# Where the SQLite database file lives (server-relative)
DATABASE_FILE=./data/taskflow.db

# Set to "true" only when the app is served over HTTPS in production
# so the auth cookie is sent with the Secure flag.
COOKIE_SECURE=false

# --- Client (Vite) ----------------------------------------------
# Base path for API calls. Keep "/api" locally: Vite proxies it to PORT.
VITE_API_BASE_URL=/api
